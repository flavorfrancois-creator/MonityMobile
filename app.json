{
  "expo": {
    "name": "Monity World",
    "slug": "monity-world-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "monityworld",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monityworld.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanner les codes-barres des cartes Monity",
        "NFCReaderUsageDescription": "Lire les cartes NFC Monity pour paiements",
        "NSPhotoLibraryUsageDescription": "Sauvegarder les reçus de transaction",
        "NSContactsUsageDescription": "Trouver rapidement vos contacts",
        "NSFaceIDUsageDescription": "Authentification sécurisée"
      }
    },
    "android": {
      "package": "com.monityworld.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanner les codes-barres Monity"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0f"
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Lire les cartes NFC Monity"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/mobile-app"
    },
    "extra": {
      "apiUrl": "https://www.monityworld.link",
      "router": {},
      "eas": {
        "projectId": "09b835f1-b6fd-4e79-8092-6506f6e79781"
      }
    },
    "owner": "flavoren"
  }
}
